---
import '../styles/global.css';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/'; // "/wc26/"
const SITE = 'https://www.tahabouhsine.com';
const KICKOFF = '2026-06-11T15:00:00-06:00'; // opening match
const {
  title = 'WC26 Matchday — FIFA World Cup 2026',
  description = 'Explore every 2026 FIFA World Cup squad, projected lineup, club and match — 1,247 players, 48 teams, 104 matches.',
  jsonld = null,
  ogImage = B + 'og.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const NAV = [['', 'Home'], ['teams/', 'Teams'], ['players/', 'Players'], ['clubs/', 'Clubs'], ['groups/', 'Groups'], ['bracket/', 'Bracket'], ['matches/', 'Matches'], ['map/', 'Map'], ['compare/', 'Compare'], ['insights/', 'Insights'], ['data/', 'Data']];
const here = Astro.url.pathname.replace(/\/$/, '') + '/';
const isOn = (p) => { const full = (B + p).replace(/\/$/, '') + '/'; return p === '' ? here === B : here.startsWith(full); };
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Taha Bouhsine" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#080b10" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="WC26 Matchday" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href={B + 'favicon.svg'} />
  <link rel="apple-touch-icon" href={B + 'favicon.svg'} />
  <link rel="manifest" href={B + 'site.webmanifest'} />
  <link rel="sitemap" href={B + 'sitemap-index.xml'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>
  <header class="topbar">
    <a class="brand" href={B} aria-label="WC26 Matchday home">
      <span class="mark" aria-hidden="true"></span>
      <span class="wm">WC<b>26</b> <em>Matchday</em></span>
    </a>
    <nav id="nav" aria-label="Primary">
      {NAV.map(([p, l]) => <a href={B + p} class={isOn(p) ? 'on' : ''}><span>{l}</span></a>)}
    </nav>
    <div class="actions">
      <a class="navcd" id="navcd" href={B + 'matches/1/'} title="Time to the opening match">
        <span class="livedot"></span><span id="navcd-t" class="mono">—</span>
      </a>
      <button class="searchpill" id="palBtn" aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="sp-t">Search</span><kbd>⌘K</kbd>
      </button>
      <button class="iconbtn" id="themeb" aria-label="Toggle theme">☀️</button>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot faint">FIFA World Cup 2026 data explorer · 1,247 players · projected lineups are estimates, not official lineups. · <a href={B + 'data/'}>Data &amp; sources</a></footer>

  <div class="palette" id="palette" role="dialog" aria-modal="true" aria-label="Search">
    <div class="palbox">
      <input id="palq" placeholder="Search players, teams, clubs, cities…" aria-label="Search" autocomplete="off" />
      <div id="palres" class="palres"></div>
      <div class="palfoot faint">↑↓ navigate · ↵ open · esc close</div>
    </div>
  </div>

  <script define:vars={{ B, KICKOFF }}>
    window.__B__ = B;
    // a11y: make clickable table rows keyboard-operable
    document.querySelectorAll('tr[onclick]').forEach(tr => {
      tr.tabIndex = 0; tr.setAttribute('role', 'link');
      tr.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); tr.click(); } });
    });
    // navbar live countdown chip
    (function () {
      const el = document.getElementById('navcd-t'); if (!el) return;
      const target = new Date(KICKOFF).getTime();
      function upd() {
        const d = target - Date.now();
        if (d <= 0) { el.textContent = 'LIVE'; document.getElementById('navcd').classList.add('live'); return; }
        const days = Math.floor(d / 864e5), h = Math.floor(d / 36e5) % 24, m = Math.floor(d / 6e4) % 60;
        el.textContent = days > 0 ? days + 'd ' + h + 'h' : h + 'h ' + m + 'm';
      }
      upd(); setInterval(upd, 30000);
    })();
    // theme
    const SUN = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>';
    const MOON = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
    const setTheme = t => { document.documentElement.dataset.theme = t; localStorage.setItem('wc-theme', t); const b = document.getElementById('themeb'); if (b) b.innerHTML = t === 'light' ? MOON : SUN; };
    setTheme(localStorage.getItem('wc-theme') || 'dark');
    document.getElementById('themeb').addEventListener('click', () => setTheme((localStorage.getItem('wc-theme') || 'dark') === 'dark' ? 'light' : 'dark'));
    // command palette (lazy index)
    let IDX = null, sel = 0;
    const pal = document.getElementById('palette'), q = document.getElementById('palq'), res = document.getElementById('palres');
    async function ensure() { if (!IDX) { try { IDX = await (await fetch(B + 'search.json')).json(); } catch (e) { IDX = []; } } }
    function draw() {
      const t = q.value.toLowerCase().trim();
      let r = t ? IDX.filter(x => x.s.includes(t)) : IDX.filter(x => x.t === 'Page' || x.t === 'Team');
      r = r.slice(0, 40); sel = 0;
      res.innerHTML = r.map((x, i) => `<a class="palrow ${i === 0 ? 'sel' : ''}" href="${B}${x.u}"><span class="palk">${x.k || x.t[0]}</span><span class="pall">${x.n}</span><span class="palsub faint">${x.d || ''}</span><span class="palt faint">${x.t}</span></a>`).join('') || '<div class="palrow faint">No matches.</div>';
    }
    async function open() { await ensure(); pal.classList.add('show'); q.value = ''; draw(); q.focus(); }
    function close() { pal.classList.remove('show'); }
    document.getElementById('palBtn').addEventListener('click', open);
    q.addEventListener('input', draw);
    pal.addEventListener('click', e => { if (e.target === pal) close(); });
    q.addEventListener('keydown', e => {
      const rows = [...res.querySelectorAll('.palrow[href]')];
      if (e.key === 'ArrowDown') { e.preventDefault(); rows[sel]?.classList.remove('sel'); sel = Math.min(sel + 1, rows.length - 1); rows[sel]?.classList.add('sel'); rows[sel]?.scrollIntoView({ block: 'nearest' }); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); rows[sel]?.classList.remove('sel'); sel = Math.max(sel - 1, 0); rows[sel]?.classList.add('sel'); rows[sel]?.scrollIntoView({ block: 'nearest' }); }
      else if (e.key === 'Enter') { e.preventDefault(); (rows[sel] || rows[0])?.click(); }
    });
    document.addEventListener('keydown', e => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
      else if (e.key === '/' && !/input|select|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); open(); }
      else if (e.key === 'Escape') close();
    });
  </script>
</body>
</html>
