---
import Flag from './Flag.astro';
import { rating, tier, tierName, SPECIAL, monogram } from '../lib/wc.js';
const { p, big = false } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const r = rating(p);
const tr = tier(p);
const badge = SPECIAL.has(tr) ? tierName(tr) : null;
// face: real photo if present (public/faces/<id>.png), else an avatar placeholder, else monogram
const avatar = `https://api.dicebear.com/9.x/micah/svg?seed=${encodeURIComponent(p.player_name)}&radius=0&backgroundColor=transparent`;
const faceUrl = `${B}faces/${p.player_id}.png`;
const stats = [
  ['GLS', p.international_goals], ['DRI', p.club_assists_2025_26],
  ['CAP', p.caps], ['APP', p.club_apps_2025_26],
  ['G26', p.club_goals_2025_26], ['AGE', p.age],
];
---
<a class={`fut ${tr}${big ? ' big' : ''}`} href={`${B}players/${p.player_id}/`} title={p.player_name}>
  <div class="fut-sheen"></div>
  {badge && <span class="fut-badge">{badge}</span>}
  <div class="fut-top">
    <div class="fut-ovr"><b>{r}</b><span>{p.position}</span></div>
    <div class="fut-id">
      <Flag code={p.fifa_code} />
      <span class="fut-num">#{p.shirt_number ?? '–'}</span>
      {p.is_captain && <span class="fut-cap">C</span>}
    </div>
  </div>
  <div class="fut-face">
    <span class="fut-mono">{monogram(p.player_name)}</span>
    <img src={faceUrl} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${avatar}'`} />
  </div>
  <div class="fut-name">{p.player_name}</div>
  <div class="fut-stats">
    {stats.map(([k, v]) => <span><b>{v ?? '–'}</b>{k}</span>)}
  </div>
</a>
