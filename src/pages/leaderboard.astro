---
// Player ranking was merged into the Players page. Keep this path as a redirect
// so existing links / shares still resolve.
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const to = B + 'players/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Player ranking → Players</title>
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <link rel="canonical" href={to} />
  <meta name="robots" content="noindex, follow" />
</head>
<body>Redirecting to the <a href={to}>player ranking</a>…</body>
</html>
