---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../../public/data.json';
import { indexes, autoForm, pickXI, FORMATIONS, surname, num, money, avgAge } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const HOME = '#e9bb4c', AWAY = '#5b9cff';
const IDX = indexes(DB);
export function getStaticPaths() {
  return DB.matches.map(m => ({ params: { n: String(m.match_number) } }));
}
const m = DB.matches.find(x => String(x.match_number) === Astro.params.n);
const ht = m.home_code ? IDX.teamByCode[m.home_code] : null;
const at = m.away_code ? IDX.teamByCode[m.away_code] : null;
const sum = (t, k) => (IDX.playersByTeam[t.fifa_code] || []).reduce((s, p) => s + (p[k] || 0), 0);
const aa = t => avgAge(IDX.playersByTeam[t.fifa_code] || []) || 0;
const kick = (m.kickoff_at || '').replace(' ', 'T').replace(/([+-]\d{2})$/, '$1:00');

let tokens = [], hf2 = '', af2 = '';
if (ht && at) {
  const hsq = IDX.playersByTeam[ht.fifa_code], asq = IDX.playersByTeam[at.fifa_code];
  const hf = autoForm(hsq), af = autoForm(asq); hf2 = hf; af2 = af;
  const hx = pickXI(hsq, hf), ax = pickXI(asq, af);
  const hById = {}; hsq.forEach(p => hById[p.player_id] = p);
  const aById = {}; asq.forEach(p => aById[p.player_id] = p);
  const mk = (xi, form, byId, bottom, col) => xi.map((id, i) => {
    const p = id ? byId[id] : null, [, x, y] = FORMATIONS[form][i];
    return { x: bottom ? x : 100 - x, y: bottom ? 50 + (y / 100) * 47 : 50 - (y / 100) * 47, n: p ? (p.shirt_number ?? '') : '', nm: p ? surname(p.player_name) : '', id, col };
  });
  tokens = [...mk(ax, af, aById, false, AWAY), ...mk(hx, hf, hById, true, HOME)];
}

// tale of the tape as comparison bars
const metric = (label, a, b, fmt, better) => {
  const tot = (a + b) || 1;
  let shareA = better === 'low' ? b / tot * 100 : better === null ? 50 : a / tot * 100;
  const win = better === null ? '' : better === 'low' ? (a < b ? 'A' : a > b ? 'B' : '') : (a > b ? 'A' : a < b ? 'B' : '');
  return { label, fa: fmt(a), fb: fmt(b), shareA, win };
};
const tape = (ht && at) ? [
  metric('FIFA ranking', ht.fifa_ranking || 999, at.fifa_ranking || 999, x => x >= 999 ? '—' : '#' + x, 'low'),
  metric('Squad value', sum(ht, 'market_value_eur'), sum(at, 'market_value_eur'), x => x ? money(x) : '—', 'high'),
  metric('Total caps', sum(ht, 'caps'), sum(at, 'caps'), num, 'high'),
  metric('Intl goals', sum(ht, 'international_goals'), sum(at, 'international_goals'), num, 'high'),
  metric('Avg age', aa(ht), aa(at), x => x ? x.toFixed(1) : '—', null),
] : [];
// key man per side
const star = t => [...(IDX.playersByTeam[t.fifa_code] || [])].sort((a, b) => (b.international_goals || 0) - (a.international_goals || 0))[0];
const sH = ht && star(ht), sA = at && star(at);

const lbl = (m.match_label || '').split(/\s+vs\s+/);
const titleTeams = ht && at ? `${ht.team_name} vs ${at.team_name}` : m.match_label;
const desc = `${m.stage} · ${titleTeams} at the 2026 FIFA World Cup — ${(m.kickoff_at || '').slice(0, 10)}, ${m.venue}, ${m.city}. Projected lineups and head-to-head.`;
---
<Base title={`${titleTeams} — 2026 World Cup ${m.stage} (Match ${m.match_number})`} description={desc} ogImage={B + 'og/match/' + m.match_number + '.png'}>
  <div class="app-page">
  <a class="btn back" href={B + 'matches/'}>← Schedule</a>

  <section class="mscore2">
    <div class="ms-team">
      {ht ? <Flag code={ht.fifa_code} cls="lg" /> : <div class="ms-slot">{lbl[0]}</div>}
      <div class="ms-name">{ht ? ht.team_name : 'TBD'}</div>
      {ht && <div class="ms-sub">{ht.head_coach} · FIFA {ht.fifa_ranking ? '#' + ht.fifa_ranking : '—'}</div>}
    </div>
    <div class="ms-vs">
      <div class="ms-stage">{m.stage}</div>
      <div class="ms-vstxt">VS</div>
      {kick && <div class="ms-cd" id="mcd" data-kick={kick}>—</div>}
      <div class="ms-when">{(m.kickoff_at || '').slice(0, 10)}</div>
    </div>
    <div class="ms-team">
      {at ? <Flag code={at.fifa_code} cls="lg" /> : <div class="ms-slot">{lbl[1]}</div>}
      <div class="ms-name">{at ? at.team_name : 'TBD'}</div>
      {at && <div class="ms-sub">{at.head_coach} · FIFA {at.fifa_ranking ? '#' + at.fifa_ranking : '—'}</div>}
    </div>
  </section>
  <div class="ms-meta faint">{m.venue}, {m.city}, {m.country} · {(m.kickoff_at || '').replace('T', ' ')}</div>

  <div class="app-grow scroll">
  {ht && at ? (
    <div class="grid2" style="margin-top:16px">
      <div class="panel">
        <h3>Tale of the tape</h3>
        <div class="tot-head"><span class="dotg"></span>{ht.team_name}<span style="flex:1"></span>{at.team_name}<span class="dotb"></span></div>
        {tape.map(t => (
          <div class="tot">
            <div class="tot-top"><b class={t.win === 'A' ? 'w' : ''}>{t.fa}</b><span class="tot-l">{t.label}</span><b class={t.win === 'B' ? 'w' : ''}>{t.fb}</b></div>
            <div class="tot-bar"><i class="ta" style={`width:${t.shareA}%`}></i><i class="tb" style={`width:${100 - t.shareA}%`}></i></div>
          </div>
        ))}
      </div>
      <div class="panel">
        <h3>Key man duel</h3>
        <div class="duel">
          {[[sH, ht, HOME], [sA, at, AWAY]].map(([s, t, c]) => s && (
            <a class="duelman" href={`${B}players/${s.player_id}/`}>
              <div class="duel-num" style={`color:${c}`}>{s.shirt_number ?? ''}</div>
              <div><div class="duel-nm">{s.player_name}</div><div class="faint" style="font-size:12px">{s.club}</div>
                <div class="duel-st"><b>{s.international_goals ?? 0}</b> goals · <b>{s.caps ?? 0}</b> caps</div></div>
            </a>
          ))}
        </div>
        <div class="faint" style="font-size:12px;margin-top:10px">Top international scorer in each squad.</div>
      </div>
    </div>
  ) : (
    <div class="panel" style="margin-top:16px"><div class="faint">This is a knockout slot — the two teams are decided by earlier results ({m.match_label}). The matchup fills in once both are known.</div></div>
  )}

  {ht && at && (
    <div class="panel">
      <h3>Projected head-to-head XIs <span class="tag">auto-picked — not official lineups</span></h3>
      <div class="mhead"><span><span class="dotg"></span> {ht.team_name} <span class="faint">{hf2}</span></span><span><span class="faint">{af2}</span> {at.team_name} <span class="dotb"></span></span></div>
      <div class="pitch tall">
        <div class="line ch"></div><div class="line cc"></div><div class="line box top"></div><div class="line box bot"></div><div class="line six top"></div><div class="line six bot"></div>
        {tokens.map(tk => (
          <a class="token sm" style={`left:${tk.x}%;top:${tk.y}%`} href={tk.id ? `${B}players/${tk.id}/` : '#'} title={tk.nm}>
            <div class="sh" style={`--tc:${tk.col}`}>{tk.n}</div><div class="nm">{tk.nm}</div>
          </a>
        ))}
      </div>
    </div>
  )}
  </div>
  </div>

  {kick && (
    <script is:inline>
      (function () {
        var cd = document.getElementById('mcd'); if (!cd) return;
        var t = new Date(cd.dataset.kick).getTime();
        function u() { var d = t - Date.now(); if (d <= 0) { cd.textContent = 'Kicked off'; return; } var days = Math.floor(d / 864e5), h = Math.floor(d / 36e5) % 24, m = Math.floor(d / 6e4) % 60; cd.textContent = (days > 0 ? days + 'd ' : '') + h + 'h ' + m + 'm'; }
        u(); setInterval(u, 30000);
      })();
    </script>
  )}
</Base>
