---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../../public/data.json';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const matches = [...DB.matches].sort((a, b) => (a.kickoff_at || '').localeCompare(b.kickoff_at || ''));
const stages = [...new Set(DB.matches.map(m => m.stage))];
---
<Base title="Match schedule — all 104 fixtures of the 2026 FIFA World Cup" description="The complete 2026 FIFA World Cup schedule: all 104 matches with kickoff times, venues and host cities. Open a match for projected head-to-head lineups.">
  <div class="app-page">
  <header class="phead">
    <div>
      <div class="pe">Fixtures</div>
      <h1>104 matches</h1>
      <p class="psub">The full schedule, June 11 to July 19. Open any match for projected head-to-head XIs and the tale of the tape.</p>
    </div>
    <div class="pstat"><div class="s"><b>104</b><span>Matches</span></div><div class="s"><b>{stages.length}</b><span>Stages</span></div></div>
  </header>
  <div class="panel app-grow">
    <div class="controls">
      <select id="ss"><option value="">All stages</option>{stages.map(s => <option>{s}</option>)}</select>
      <span class="count" id="mc"></span>
    </div>
    <div class="tablewrap">
      <table>
        <thead><tr><th>#</th><th>Kickoff</th><th>Stage</th><th>Match</th><th>Venue</th></tr></thead>
        <tbody id="mb">
          {matches.map(m => (
            <tr data-stage={m.stage} onclick={`location.href='${B}matches/${m.match_number}/'`}>
              <td class="mono">{m.match_number}</td>
              <td class="faint mono">{(m.kickoff_at || '').replace('T', ' ').slice(0, 16)}</td>
              <td>{m.match_label}</td>
              <td>{m.home_code
                ? <span class="nat"><Flag code={m.home_code} cls="sm" /> {m.home_team} <span class="faint">v</span> <Flag code={m.away_code} cls="sm" /> {m.away_team}</span>
                : <span class="faint">{m.match_label}</span>}</td>
              <td class="faint">{m.venue}, {(m.city || '').split('/')[0]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  </div>
  <script>
    const ss = document.getElementById('ss'), rows = [...document.getElementById('mb').children], mc = document.getElementById('mc');
    function apply() { let n = 0; rows.forEach(r => { const ok = !ss.value || r.dataset.stage === ss.value; r.style.display = ok ? '' : 'none'; if (ok) n++; }); mc.textContent = n + ' matches'; }
    ss.addEventListener('change', apply); apply();
  </script>
</Base>
