---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../public/data.json';
import { teamRating, predictMatch, explainMatch, simulateTournament } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const T = {}; DB.teams.forEach(t => T[t.fifa_code] = t);
const nm = c => T[c] ? T[c].team_name : c;
const fmtDay = (s) => { const d = new Date((s || '').replace(' ', 'T').replace(/([+-]\d{2})$/, '$1:00')); return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); };

const sim = simulateTournament(DB);
const champ = T[sim.champion], runner = T[sim.runnerUp];
const finalP = predictMatch(champ, runner);
// orient the final score so the champion's tally is the winning one
const cWin = finalP.ha >= finalP.aa ? [finalP.ha, finalP.aa] : [finalP.aa, finalP.ha];
const semis = sim.semifinalists.map(c => T[c]);

// every group-stage prediction (with explanation), grouped by group letter
const groupMatches = DB.matches
  .filter(m => m.match_label && m.match_label.startsWith('Group') && m.home_code && m.away_code)
  .map(m => {
    const p = predictMatch(T[m.home_code], T[m.away_code]);
    const fav = p.pH > p.pA && p.pH >= p.pD ? m.home_team : p.pA > p.pH && p.pA >= p.pD ? m.away_team : null;
    return { ...m, g: m.match_label.replace('Group ', ''), p, fav, why: explainMatch(T[m.home_code], T[m.away_code], p) };
  })
  .sort((a, b) => a.g.localeCompare(b.g) || a.match_number - b.match_number);
const groups = {}; groupMatches.forEach(m => (groups[m.g] = groups[m.g] || []).push(m));
const letters = Object.keys(groups).sort();
const qualifiedHelp = (rows, code) => { const r = rows.find(x => x.code === code); if (!r) return ''; return r.rank <= 2 ? 'adv' : (r.rank === 3 && sim.qual3.includes(code)) ? 'thrd' : 'out'; };

const desc = `Our AI predicts ${champ.team_name} to win the 2026 FIFA World Cup, beating ${runner.team_name} ${cWin[0]}–${cWin[1]} in the final. Full AI score predictions, group tables and win probabilities for all ${groupMatches.length} group-stage matches — with a plain-English reason for every result.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Who will win the 2026 World Cup?', acceptedAnswer: { '@type': 'Answer', text: `Our AI model predicts ${champ.team_name} to win the 2026 FIFA World Cup, beating ${runner.team_name} ${cWin[0]}–${cWin[1]} in the final. The predicted semi-finalists are ${semis.map(t => t.team_name).join(', ')}.` } },
    ...groupMatches.slice(0, 16).map(m => ({ '@type': 'Question', name: `${m.home_team} vs ${m.away_team} prediction`, acceptedAnswer: { '@type': 'Answer', text: `Predicted score: ${m.home_team} ${m.p.ha}–${m.p.aa} ${m.away_team}. ${m.why}` } })),
  ],
};
---
<Base title={`World Cup 2026 Predictions: ${champ.team_name} to Win — AI Score for Every Match`} description={desc} jsonld={jsonld}>
  <div class="app-page">
    <header class="phead">
      <div>
        <div class="pe">AI predictions · who wins it all</div>
        <h1>World Cup 2026 predictions</h1>
        <p class="psub">An AI model predicts every group game, simulates the whole bracket, and crowns a champion — each call backed by a plain-English reason.</p>
      </div>
      <div class="pstat">
        <div class="s"><b>{groupMatches.length}</b><span>Predictions</span></div>
        <div class="s"><b>48→1</b><span>Simulated</span></div>
      </div>
    </header>

    <div class="app-grow scroll">
      <!-- CHAMPION -->
      <section class="pchamp-hero">
        <div class="pch-trophy">🏆</div>
        <div class="pch-body">
          <div class="pch-eye">Predicted World Champion</div>
          <a class="pch-team" href={`${B}teams/${champ.fifa_code.toLowerCase()}/`}><Flag code={champ.fifa_code} cls="lg" /> <b>{champ.team_name}</b></a>
          <div class="pch-final">Beats <a href={`${B}teams/${runner.fifa_code.toLowerCase()}/`}>{runner.team_name}</a> <b class="pch-score">{cWin[0]}–{cWin[1]}</b> in the final · Jul 19, New York</div>
        </div>
        <div class="pch-semis">
          <div class="pch-semis-h">Predicted semi-finalists</div>
          <div class="pch-semis-row">
            {semis.map(t => <a class="pch-semi" href={`${B}teams/${t.fifa_code.toLowerCase()}/`}><Flag code={t.fifa_code} cls="sm" /> {t.fifa_code}</a>)}
          </div>
        </div>
      </section>

      <p class="pr-intro">Below is an <b>AI score prediction for every group-stage match</b>, the <b>projected group tables</b> (points), and <b>win/draw/loss probabilities</b> — all from a model that scores each team's attack against the other's defence using squad ratings, 2025/26 club goals & assists and goalkeeping form. Tap any match for the full head-to-head. <a href={`${B}bracket/`}>See the full knockout bracket →</a></p>

      {letters.map(g => {
        const rows = sim.standings[g];
        return (
        <section class="pr-group">
          <h2 class="pr-gh"><span class="pr-gl">{g}</span> Group {g} predictions</h2>
          <div class="pr-cols">
            <div class="pr-table">
              <div class="prt-row prt-head"><span>#</span><span>Team</span><span>Pld</span><span>GD</span><span>Pts</span></div>
              {rows.map((r) => (
                <div class={`prt-row ${qualifiedHelp(rows, r.code)}`}>
                  <span class="prt-pos">{r.rank}</span>
                  <span class="prt-team"><Flag code={r.code} cls="sm" /> {r.name}</span>
                  <span class="mono">{r.P}</span><span class="mono">{r.GD > 0 ? '+' + r.GD : r.GD}</span><span class="mono"><b>{r.Pts}</b></span>
                </div>
              ))}
              <div class="prt-key faint">Top 2 advance · 3rd may qualify as a best third</div>
            </div>
            <div class="pr-fixtures">
              {groups[g].map(m => (
                <a class="pr-fx" href={`${B}matches/${m.match_number}/`}>
                  <span class="pr-fxhead">
                    <span class="pr-day">{fmtDay(m.kickoff_at)}</span>
                    <span class="pr-fxteams"><Flag code={m.home_code} cls="sm" /> <b>{m.home_team}</b> <span class="pr-fxscore">{m.p.ha}<i>–</i>{m.p.aa}</span> <b>{m.away_team}</b> <Flag code={m.away_code} cls="sm" /></span>
                    <span class="pr-fxprob">{m.p.pH}/{m.p.pD}/{m.p.pA}%</span>
                  </span>
                  <span class="pr-why">{m.why}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
        );
      })}

      <p class="pr-method faint">How it works: every squad is scored for attack and defence from its players — strength ratings, 2025/26 club goals and assists, international goals, goalkeeping and clean sheets — blended with FIFA-ranking pedigree. The model pits each team's attack against the other's defence for an expected-goals figure, takes the most-likely scoreline and win/draw/loss probabilities from a Poisson distribution, then simulates the group tables and the entire knockout bracket to a champion. It's a model, not a crystal ball — upsets are the best part of the World Cup.</p>
    </div>
  </div>
</Base>
