---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../public/data.json';
import { teamRating, predictMatch } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const rOf = {}, nameOf = {};
DB.teams.forEach(t => { rOf[t.fifa_code] = teamRating(t.fifa_ranking) || 60; nameOf[t.fifa_code] = t.team_name; });
const fmtDay = (s) => { const d = new Date((s || '').replace(' ', 'T').replace(/([+-]\d{2})$/, '$1:00')); return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); };

// every group-stage match with a prediction, grouped by group letter
const groupMatches = DB.matches
  .filter(m => m.match_label && m.match_label.startsWith('Group') && m.home_code && m.away_code)
  .map(m => {
    const p = predictMatch(rOf[m.home_code], rOf[m.away_code]);
    const fav = p.pH > p.pA && p.pH >= p.pD ? m.home_team : p.pA > p.pH && p.pA >= p.pD ? m.away_team : null;
    return { ...m, g: m.match_label.replace('Group ', ''), p, fav };
  })
  .sort((a, b) => a.g.localeCompare(b.g) || a.match_number - b.match_number);
const groups = {};
groupMatches.forEach(m => (groups[m.g] = groups[m.g] || []).push(m));
const letters = Object.keys(groups).sort();
const totalGoals = groupMatches.reduce((s, m) => s + m.p.ha + m.p.aa, 0);
const homeWins = groupMatches.filter(m => m.p.ha > m.p.aa).length;
const draws = groupMatches.filter(m => m.p.ha === m.p.aa).length;

const desc = `AI score predictions for all ${groupMatches.length} group-stage matches of the 2026 FIFA World Cup. Every predicted scoreline with win, draw and loss probabilities — generated from a Poisson expected-goals model built on team strength ratings.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: groupMatches.slice(0, 20).map(m => ({
    '@type': 'Question', name: `${m.home_team} vs ${m.away_team} prediction`,
    acceptedAnswer: { '@type': 'Answer', text: `Predicted score: ${m.home_team} ${m.p.ha}–${m.p.aa} ${m.away_team}. ${m.fav ? m.fav + ' favoured' : 'Too close to call'} (win ${m.p.pH}%, draw ${m.p.pD}%, win ${m.p.pA}%).` },
  })),
};
---
<Base title="World Cup 2026 Predictions — AI Score Prediction for Every Group Match" description={desc} jsonld={jsonld}>
  <div class="app-page">
    <header class="phead">
      <div>
        <div class="pe">AI score predictions</div>
        <h1>World Cup 2026 predictions</h1>
        <p class="psub">AI-predicted scorelines for every group-stage match — with win, draw and loss probabilities from a Poisson expected-goals model on team strength.</p>
      </div>
      <div class="pstat">
        <div class="s"><b>{groupMatches.length}</b><span>Matches</span></div>
        <div class="s"><b>{(totalGoals / groupMatches.length).toFixed(1)}</b><span>Goals/game</span></div>
        <div class="s"><b>{draws}</b><span>Draws tipped</span></div>
      </div>
    </header>

    <div class="app-grow scroll">
      <p class="pr-intro">Every fixture below carries an <b>AI predicted score</b> — the single most-likely scoreline from a Poisson model fed by each team's strength rating. Open a match for the full head-to-head, projected XIs and tale of the tape. Predictions refresh automatically and become live results once the tournament kicks off.</p>

      {letters.map(g => (
        <section class="pr-group">
          <h2 class="pr-gh"><span class="pr-gl">{g}</span> Group {g}</h2>
          <div class="pr-grid">
            {groups[g].map(m => (
              <a class="pr-card" href={`${B}matches/${m.match_number}/`}>
                <span class="pr-day">{fmtDay(m.kickoff_at)}</span>
                <span class="pr-row">
                  <span class="pr-team pr-h"><Flag code={m.home_code} cls="sm" /> <b>{m.home_team}</b></span>
                  <span class="pr-score">{m.p.ha}<i>–</i>{m.p.aa}</span>
                  <span class="pr-team pr-a"><b>{m.away_team}</b> <Flag code={m.away_code} cls="sm" /></span>
                </span>
                <span class="pr-prob">
                  <span class="pr-pbar"><i class="pr-ph" style={`width:${m.p.pH}%`}></i><i class="pr-pd" style={`width:${m.p.pD}%`}></i><i class="pr-pa" style={`width:${m.p.pA}%`}></i></span>
                  <span class="pr-pleg">{m.p.pH}% · {m.p.pD}% · {m.p.pA}%</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <p class="pr-method faint">How it works: each team gets a strength rating derived from its FIFA world ranking. The model converts the gap between two teams into an expected-goals figure for each side, then takes the most-likely exact scoreline from a Poisson distribution and the win/draw/loss probabilities. It's a model, not a crystal ball — upsets are the best part of the World Cup.</p>
    </div>
  </div>
</Base>
