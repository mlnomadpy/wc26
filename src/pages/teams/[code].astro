---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../../public/data.json';
import { indexes, autoForm, pickXI, FORMATIONS, FORMNAMES, POSC, CONF, surname, num, money, avgAge, flagImg, teamRating, rating, tier, monogram } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const IDX = indexes(DB);
export function getStaticPaths() {
  return DB.teams.map(t => ({ params: { code: t.fifa_code.toLowerCase() } }));
}
const code = Astro.params.code.toUpperCase();
const t = IDX.teamByCode[code];
const sq = IDX.playersByTeam[code] || [];
const byId = {}; sq.forEach(p => byId[p.player_id] = p);
const form = autoForm(sq);
const xi = pickXI(sq, form);
const onPitch = new Set(xi.filter(Boolean));
const lineAvg = (ids) => {
  const ps = ids.filter(Boolean).map(id => byId[id]).filter(Boolean);
  const a = arr => arr.length ? Math.round(arr.reduce((s, p) => s + rating(p), 0) / arr.length) : '–';
  return { ovr: a(ps), att: a(ps.filter(p => p.position === 'FW')), mid: a(ps.filter(p => p.position === 'MF')), def: a(ps.filter(p => p.position === 'DF')) };
};
const xiStat = lineAvg(xi);
const av = avgAge(sq);
const POS_ORDER = { GK: 0, DF: 1, MF: 2, FW: 3 };
const byPosCount = { GK: 0, DF: 0, MF: 0, FW: 0 }; sq.forEach(p => byPosCount[p.position] != null && byPosCount[p.position]++);
const squadSorted = [...sq].sort((a, b) => (POS_ORDER[a.position] - POS_ORDER[b.position]) || ((a.shirt_number || 99) - (b.shirt_number || 99)));
const totG = sq.reduce((s, p) => s + (p.international_goals || 0), 0), totC = sq.reduce((s, p) => s + (p.caps || 0), 0);
const val = sq.reduce((s, p) => s + (p.market_value_eur || 0), 0);
const abroad = sq.filter(p => p.club_country && p.club_country !== t.team_name).length;
const topCap = [...sq].sort((a, b) => (b.caps || 0) - (a.caps || 0))[0];
const topSc = [...sq].sort((a, b) => (b.international_goals || 0) - (a.international_goals || 0))[0];
const tRating = teamRating(t.fifa_ranking);
const desc = `${t.team_name} 2026 FIFA World Cup squad (Group ${t.group_letter}): all ${sq.length} players, projected XI, coach ${t.head_coach || ''}.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'SportsTeam', name: t.team_name, sport: 'Association football',
  url: new URL(Astro.url.pathname, 'https://www.tahabouhsine.com').href,
  coach: t.head_coach ? { '@type': 'Person', name: t.head_coach } : undefined,
  athlete: sq.map(p => ({ '@type': 'Person', name: p.player_name })),
};
const POSF = [['', 'All', sq.length], ['GK', 'GK', byPosCount.GK], ['DF', 'DF', byPosCount.DF], ['MF', 'MF', byPosCount.MF], ['FW', 'FW', byPosCount.FW]];
const STATS = [['Rating', tRating ?? '—', true], ['FIFA', t.fifa_ranking ? '#' + t.fifa_ranking : '—'], ['Value', val ? money(val) : '—'], ['Caps', num(totC)], ['Goals', num(totG)], ['Age', av ? av.toFixed(1) : '—']];
const face = id => `${B}faces/${id}.jpg`;
---
<Base title={`${t.team_name} — 2026 World Cup squad, lineup & stats`} description={desc} jsonld={jsonld} ogImage={B + 'og/team/' + t.fifa_code.toLowerCase() + '.png'}>
  <div class="app-page tv2">
  <header class="tv2-bar" style={`--c:${CONF[t.confederation]}`}>
    <a class="tv2-back" href={B + 'teams/'} aria-label="All teams">←</a>
    <Flag code={t.fifa_code} cls="tv2-flag" w={80} />
    <div class="tv2-id">
      <h1>{t.team_name}</h1>
      <span class="tv2-sub">{t.head_coach || '—'} · <a class="dh-glink" href={`${B}groups/${t.group_letter}/`}>Group {t.group_letter}</a> · {t.confederation} · {sq.length} players</span>
    </div>
    <div class="tv2-stats">
      {STATS.map(([k, v, hero]) => <span class={`tv2-stat ${hero ? 'hero' : ''}`}><b>{v}</b><i>{k}</i></span>)}
    </div>
  </header>

  <div class="app-grow tv2-main">
    <!-- LEFT — lineup, always visible -->
    <section class="panel tv2-pitch" id="teamroot" data-form={form}>
      <div class="tv2-h">
        <h3>Projected XI <span class="tag">auto-picked · {form}</span></h3>
        <div class="formrow">{FORMNAMES.map(f => <span class={`chip ${f === form ? 'on' : ''}`} data-f={f}>{f}</span>)}</div>
      </div>
      <div class="pitch" id="pitch">
        <div class="line ch"></div><div class="line cc"></div><div class="line box top"></div><div class="line box bot"></div><div class="line six top"></div><div class="line six bot"></div>
        {xi.map((id, i) => { const [cat, x, y] = FORMATIONS[form][i]; const p = id ? byId[id] : null; return (
          <a class={`token ${p && p.is_captain ? 'cpt' : ''}`} style={`left:${x}%;top:${y}%`} href={id ? `${B}players/${id}/` : '#'} title={p ? p.player_name : ''}>
            <div class="sh" style={`--tc:${POSC[cat]}`}>{p ? (p.shirt_number ?? '') : ''}{p && p.is_captain && <i class="cap">C</i>}</div>
            {p && <span class="tov" style={`--tc:${POSC[cat]}`}>{rating(p)}</span>}
            <div class="nm">{p ? surname(p.player_name) : '—'}</div>
          </a>
        ); })}
      </div>
      <div class="xistat" id="xistat">
        <span class="xis-ov"><b id="xs-ov">{xiStat.ovr}</b><i>XI Rating</i></span>
        <span><b id="xs-att">{xiStat.att}</b><i>Attack</i></span>
        <span><b id="xs-mid">{xiStat.mid}</b><i>Midfield</i></span>
        <span><b id="xs-def">{xiStat.def}</b><i>Defence</i></span>
      </div>
    </section>

    <!-- RIGHT — tabbed: Squad / Profile -->
    <section class="panel tv2-right">
      <div class="rtabs" id="rtabs">
        <button class="rtab on" data-r="squad">Squad</button>
        <button class="rtab" data-r="info">Profile</button>
      </div>

      <div class="rpane" data-r="squad">
        <div class="chips posf" id="posf">
          {POSF.map(([p, label, n]) => <span class={`chip ${p === '' ? 'on' : ''}`} data-p={p}>{label} <i class="posn">{n}</i></span>)}
        </div>
        <div class="splgrid" id="squadgrid">
          {squadSorted.map(p => (
            <a class={`spl ${onPitch.has(p.player_id) ? 'on' : ''}`} data-pos={p.position} style={`--pc:${POSC[p.position]}`} href={`${B}players/${p.player_id}/`} title={p.player_name}>
              <span class="spl-face">
                <span class="spl-mono">{monogram(p.player_name)}</span>
                <img src={face(p.player_id)} alt="" loading="lazy" onerror="this.remove()" />
                <span class="spl-no">{p.shirt_number ?? ''}</span>
              </span>
              <span class="spl-id">
                <span class="spl-nm">{surname(p.player_name)}{p.is_captain ? ' (C)' : ''}</span>
                <span class="spl-meta"><span class={`pill ${p.position}`}>{p.position}</span> {p.club || ''}</span>
              </span>
              <span class={`lbovr ${tier(p)} spl-ovr`}>{rating(p)}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="rpane" data-r="info" hidden>
        <div class="kv tv2-kv">
          <span class="k">Head coach</span><span>{t.head_coach || '—'}</span>
          <span class="k">FIFA ranking</span><span>{t.fifa_ranking ? '#' + t.fifa_ranking : '—'} · rating {tRating ?? '—'}</span>
          <span class="k">Group</span><span><a class="dh-glink" href={`${B}groups/${t.group_letter}/`}>Group {t.group_letter} →</a></span>
          <span class="k">Qualified via</span><span>{t.qualification_method || '—'}</span>
          <span class="k">Average age</span><span class="mono">{av ? av.toFixed(1) : '—'}</span>
          <span class="k">Total caps</span><span class="mono">{num(totC)}</span>
          <span class="k">Total intl goals</span><span class="mono">{num(totG)}</span>
          <span class="k">Squad value</span><span class="mono">{val ? money(val) : '—'}</span>
          <span class="k">Play abroad</span><span class="mono">{abroad}/{sq.length}</span>
          <span class="k">Most capped</span><span>{topCap.player_name} <span class="faint">({topCap.caps})</span></span>
          <span class="k">Top scorer</span><span>{topSc.player_name} <span class="faint">({topSc.international_goals})</span></span>
        </div>
      </div>
    </section>
  </div>
  </div>

  <script type="application/json" id="squad" set:html={JSON.stringify(sq)}></script>
  <script>
    import { FORMATIONS, pickXI, POSC, surname, rating } from '@shared/lib/wc.js';
    // formation switcher → re-pick the pitch XI + re-flag squad cards
    const root = document.getElementById('teamroot');
    const el = document.getElementById('squad');
    if (root && el) {
      const sq = JSON.parse(el.textContent);
      const byId = {}; sq.forEach(p => byId[p.player_id] = p);
      const B = window.__B__ || '/';
      const pitch = document.getElementById('pitch');
      function render(form) {
        const xi = pickXI(sq, form);
        pitch.querySelectorAll('.token').forEach(n => n.remove());
        FORMATIONS[form].forEach((s, i) => {
          const [cat, x, y] = s, id = xi[i], p = id ? byId[id] : null;
          const a = document.createElement('a'); a.className = 'token' + (p && p.is_captain ? ' cpt' : ''); a.style.left = x + '%'; a.style.top = y + '%';
          a.href = id ? B + 'players/' + id + '/' : '#';
          a.innerHTML = `<div class="sh" style="--tc:${POSC[cat]}">${p ? (p.shirt_number ?? '') : ''}${p && p.is_captain ? '<i class="cap">C</i>' : ''}</div>${p ? `<span class="tov" style="--tc:${POSC[cat]}">${rating(p)}</span>` : ''}<div class="nm">${p ? surname(p.player_name) : '—'}</div>`;
          pitch.appendChild(a);
        });
        const on = new Set(xi.filter(Boolean));
        document.querySelectorAll('#squadgrid .spl').forEach(c => {
          const id = +(c.getAttribute('href').match(/players\/(\d+)/) || [])[1];
          c.classList.toggle('on', on.has(id));
        });
        // live XI strength readout
        const xp = xi.filter(Boolean).map(id => byId[id]).filter(Boolean);
        const avg = arr => arr.length ? Math.round(arr.reduce((s, p) => s + rating(p), 0) / arr.length) : '–';
        const set = (k, v) => { const e = document.getElementById(k); if (e) e.textContent = v; };
        set('xs-ov', avg(xp)); set('xs-att', avg(xp.filter(p => p.position === 'FW')));
        set('xs-mid', avg(xp.filter(p => p.position === 'MF'))); set('xs-def', avg(xp.filter(p => p.position === 'DF')));
      }
      document.querySelectorAll('.formrow .chip').forEach(c => c.addEventListener('click', () => {
        document.querySelectorAll('.formrow .chip').forEach(x => x.classList.toggle('on', x === c));
        render(c.dataset.f);
      }));
    }
    // right-panel tabs
    const rtabs = document.getElementById('rtabs');
    if (rtabs) {
      const panes = document.querySelectorAll('.tv2-right .rpane');
      rtabs.querySelectorAll('.rtab').forEach(b => b.addEventListener('click', () => {
        rtabs.querySelectorAll('.rtab').forEach(x => x.classList.toggle('on', x === b));
        panes.forEach(p => p.hidden = p.dataset.r !== b.dataset.r);
      }));
    }
    // squad position filter
    const posf = document.getElementById('posf');
    if (posf) {
      const items = [...document.querySelectorAll('#squadgrid .spl')];
      posf.querySelectorAll('.chip').forEach(c => c.addEventListener('click', () => {
        posf.querySelectorAll('.chip').forEach(x => x.classList.toggle('on', x === c));
        const p = c.dataset.p;
        items.forEach(it => it.classList.toggle('hide', !!p && it.dataset.pos !== p));
      }));
    }
  </script>
</Base>
