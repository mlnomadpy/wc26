---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../../public/data.json';
import { CONF, money, rating, tier, tierName } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
// single ranked list — this page IS the player ranking (sorted by our overall rating)
const ranked = [...DB.players]
  .map(p => ({ p, r: rating(p), t: tier(p) }))
  .sort((a, b) => b.r - a.r || (b.p.caps || 0) - (a.p.caps || 0))
  .map((x, i) => ({ ...x, rank: i + 1 }));
const top = ranked[0];
const teams = [...new Set(DB.players.map(p => p.team_name))].sort();
const TIERS = [['legend', 'Legend'], ['special', 'Superstar'], ['centurion', 'Centurion'], ['glove', 'Golden Glove'], ['marksman', 'Marksman'], ['maestro', 'Maestro'], ['rising', 'Rising ★'], ['gold', 'Gold'], ['silver', 'Silver'], ['bronze', 'Bronze']];
const present = new Set(ranked.map(x => x.t));
const cols = [['rank', '#'], ['ovr', 'OVR'], ['player_name', 'Player'], ['fifa_code', 'Team'], ['position', 'Pos'], ['tier', 'Tier'], ['age', 'Age'], ['caps', 'Caps'], ['international_goals', 'Goals'], ['club', 'Club'], ['market_value_eur', 'Value']];
---
<Base title="Players & ranking — all 1,247 at the 2026 FIFA World Cup" description="Every 2026 FIFA World Cup player ranked by a data-driven overall rating. Search by name, club, nation or tier (Legend, Superstar, Centurion…) and filter by position, confederation and team.">
  <div class="app-page">
  <header class="phead">
    <div>
      <div class="pe">Player ranking</div>
      <h1>1,247 players, ranked</h1>
      <p class="psub">Every call-up ordered by our overall rating ({top.p.player_name} tops it at {top.r}). Search a name, club, nation or tier — try “legend” — and filter by position, confederation or team.</p>
    </div>
    <div class="pstat"><div class="s"><b>1,247</b><span>Players</span></div><div class="s"><b>{DB.totals.clubs}</b><span>Clubs</span></div></div>
  </header>
  <div class="panel app-grow">
    <div class="controls">
      <input id="q" placeholder="Search player, club, nation or tier…" aria-label="Search players" />
      <div class="chips" id="pc">{['', 'GK', 'DF', 'MF', 'FW'].map(p => <span class={`chip ${p === '' ? 'on' : ''}`} data-p={p}>{p || 'All'}</span>)}</div>
      <select id="fti" aria-label="Tier"><option value="">All tiers</option>{TIERS.filter(([k]) => present.has(k)).map(([k, l]) => <option value={k}>{l}</option>)}</select>
      <select id="fc" aria-label="Confederation"><option value="">All confederations</option>{Object.keys(CONF).filter(c => c !== 'Unknown').map(c => <option>{c}</option>)}</select>
      <select id="ft" aria-label="Team"><option value="">All teams</option>{teams.map(t => <option>{t}</option>)}</select>
      <span class="count" id="cnt"></span>
    </div>
    <div class="tablewrap">
      <table id="ptab">
        <thead><tr>{cols.map(([k, l]) => <th data-k={k}>{l}<span class="ar"></span></th>)}</tr></thead>
        <tbody id="pb">
          {ranked.map(({ p, r, t, rank }) => (
            <tr data-pos={p.position} data-team={p.team_name} data-conf={p.confederation} data-tier={t}
                data-search={`${p.player_name} ${p.club || ''} ${p.fifa_code} ${p.team_name} ${tierName(t)}${p.is_captain ? ' captain' : ''}`.toLowerCase()}
                data-rank={rank} data-ovr={r} data-age={p.age ?? ''} data-caps={p.caps ?? ''}
                data-international_goals={p.international_goals ?? ''} data-market_value_eur={p.market_value_eur ?? ''}
                data-player_name={p.player_name} data-club={p.club ?? ''} data-fifa_code={p.fifa_code}
                onclick={`location.href='${B}players/${p.player_id}/'`}>
              <td class="mono faint">{rank}</td>
              <td><span class={`lbovr ${t}`}>{r}</span></td>
              <td>{p.player_name}{p.is_captain ? ' (C)' : ''}</td>
              <td><span class="nat"><Flag code={p.fifa_code} cls="sm" /> <span class="mono faint">{p.fifa_code}</span></span></td>
              <td><span class={`pill ${p.position}`}>{p.position}</span></td>
              <td><span class={`tchip ${t}`}>{tierName(t)}</span></td>
              <td class="mono">{p.age ?? ''}</td>
              <td class="mono">{p.caps ?? ''}</td>
              <td class="mono">{p.international_goals ?? ''}</td>
              <td class="faint">{p.club}</td>
              <td class="mono">{p.market_value_eur ? money(p.market_value_eur) : '·'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  </div>

  <script>
    const STR = new Set(['player_name', 'club', 'fifa_code', 'position', 'tier']);
    const tbody = document.getElementById('pb'), rows = [...tbody.children];
    const q = document.getElementById('q'), ft = document.getElementById('ft'), fc = document.getElementById('fc'), fti = document.getElementById('fti'), cnt = document.getElementById('cnt');
    let pos = '', sortK = 'rank', dir = 1;
    function apply() {
      const s = q.value.toLowerCase().trim(); let shown = 0;
      rows.forEach(r => {
        const ok = (!s || r.dataset.search.includes(s)) && (!ft.value || r.dataset.team === ft.value) &&
                   (!fc.value || r.dataset.conf === fc.value) && (!fti.value || r.dataset.tier === fti.value) &&
                   (!pos || r.dataset.pos === pos);
        r.style.display = ok ? '' : 'none'; if (ok) shown++;
      });
      cnt.textContent = shown.toLocaleString() + ' player' + (shown === 1 ? '' : 's');
    }
    function sortBy(k) {
      dir = (sortK === k) ? -dir : (STR.has(k) ? 1 : -1); sortK = k;
      const v = r => { const x = r.dataset[k]; return STR.has(k) ? (x || '') : (x === '' ? -Infinity : +x); };
      rows.sort((a, b) => { const x = v(a), y = v(b); return STR.has(k) ? dir * String(x).localeCompare(y) : dir * (x - y); });
      rows.forEach(r => tbody.appendChild(r));
      document.querySelectorAll('#ptab th .ar').forEach(a => a.textContent = '');
      const th = document.querySelector(`#ptab th[data-k="${k}"] .ar`); if (th) th.textContent = dir > 0 ? ' ▲' : ' ▼';
    }
    q.addEventListener('input', apply); ft.addEventListener('change', apply); fc.addEventListener('change', apply); fti.addEventListener('change', apply);
    document.querySelectorAll('#pc .chip').forEach(c => c.addEventListener('click', () => { pos = c.dataset.p; document.querySelectorAll('#pc .chip').forEach(x => x.classList.toggle('on', x === c)); apply(); }));
    document.querySelectorAll('#ptab th[data-k]').forEach(th => th.addEventListener('click', () => sortBy(th.dataset.k)));
    apply();
  </script>
</Base>
