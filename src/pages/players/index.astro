---
import Base from '../../components/Base.astro';
import DB from '../../../public/data.json';
import { CONF, flag, money } from '../../lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const players = [...DB.players].sort((a, b) => (b.caps || 0) - (a.caps || 0));
const teams = [...new Set(DB.players.map(p => p.team_name))].sort();
const cols = [['shirt_number', '#'], ['position', 'Pos'], ['player_name', 'Player'], ['fifa_code', 'Team'], ['age', 'Age'], ['club', 'Club'], ['caps', 'Caps'], ['international_goals', 'Goals'], ['club_apps_2025_26', 'Apps26'], ['club_goals_2025_26', 'G26'], ['market_value_eur', 'Value']];
---
<Base title="Players — all 1,247 at the 2026 FIFA World Cup" description="Searchable, sortable table of all 1,247 players at the 2026 FIFA World Cup: club, caps, international goals and 2025/26 club stats. Filter by team, confederation and position.">
  <div class="panel">
    <div class="controls">
      <input id="q" placeholder="Search player or club…" aria-label="Search players" />
      <select id="ft" aria-label="Team"><option value="">All teams</option>{teams.map(t => <option>{t}</option>)}</select>
      <select id="fc" aria-label="Confederation"><option value="">All confederations</option>{Object.keys(CONF).filter(c => c !== 'Unknown').map(c => <option>{c}</option>)}</select>
      <div class="chips" id="pc">{['', 'GK', 'DF', 'MF', 'FW'].map(p => <span class={`chip ${p === '' ? 'on' : ''}`} data-p={p}>{p || 'All'}</span>)}</div>
      <span class="count" id="cnt"></span>
    </div>
    <div class="tablewrap">
      <table id="ptab">
        <thead><tr>{cols.map(([k, l]) => <th data-k={k}>{l}<span class="ar"></span></th>)}</tr></thead>
        <tbody id="pb">
          {players.map(p => (
            <tr data-pos={p.position} data-team={p.team_name} data-conf={p.confederation} data-search={`${p.player_name} ${p.club || ''}`.toLowerCase()}
                data-shirt_number={p.shirt_number ?? ''} data-age={p.age ?? ''} data-caps={p.caps ?? ''} data-international_goals={p.international_goals ?? ''}
                data-club_apps_2025_26={p.club_apps_2025_26 ?? ''} data-club_goals_2025_26={p.club_goals_2025_26 ?? ''} data-market_value_eur={p.market_value_eur ?? ''}
                data-player_name={p.player_name} data-club={p.club ?? ''} data-fifa_code={p.fifa_code}
                onclick={`location.href='${B}players/${p.player_id}/'`}>
              <td class="mono">{p.shirt_number ?? ''}</td>
              <td><span class={`pill ${p.position}`}>{p.position}</span></td>
              <td>{p.player_name}{p.is_captain ? ' (C)' : ''}</td>
              <td>{flag(p.fifa_code)} <span class="mono faint">{p.fifa_code}</span></td>
              <td class="mono">{p.age ?? ''}</td>
              <td class="faint">{p.club}</td>
              <td class="mono">{p.caps ?? ''}</td><td class="mono">{p.international_goals ?? ''}</td>
              <td class="mono">{p.club_apps_2025_26 ?? '·'}</td><td class="mono">{p.club_goals_2025_26 ?? '·'}</td>
              <td class="mono">{p.market_value_eur ? money(p.market_value_eur) : '·'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const STR = new Set(['player_name', 'club', 'fifa_code', 'position']);
    const tbody = document.getElementById('pb'), rows = [...tbody.children];
    const q = document.getElementById('q'), ft = document.getElementById('ft'), fc = document.getElementById('fc'), cnt = document.getElementById('cnt');
    let pos = '', sortK = 'caps', dir = -1;
    function apply() {
      const s = q.value.toLowerCase().trim(); let shown = 0;
      rows.forEach(r => {
        const ok = (!s || r.dataset.search.includes(s)) && (!ft.value || r.dataset.team === ft.value) && (!fc.value || r.dataset.conf === fc.value) && (!pos || r.dataset.pos === pos);
        r.style.display = ok ? '' : 'none'; if (ok) shown++;
      });
      cnt.textContent = shown + ' players';
    }
    function sortBy(k) {
      dir = (sortK === k) ? -dir : (STR.has(k) ? 1 : -1); sortK = k;
      const v = r => { const x = r.dataset[k]; return STR.has(k) ? (x || '') : (x === '' ? -Infinity : +x); };
      rows.sort((a, b) => { const x = v(a), y = v(b); return STR.has(k) ? dir * String(x).localeCompare(y) : dir * (x - y); });
      rows.forEach(r => tbody.appendChild(r));
      document.querySelectorAll('#ptab th .ar').forEach(a => a.textContent = '');
      const th = document.querySelector(`#ptab th[data-k="${k}"] .ar`); if (th) th.textContent = dir > 0 ? ' ▲' : ' ▼';
    }
    q.addEventListener('input', apply); ft.addEventListener('change', apply); fc.addEventListener('change', apply);
    document.querySelectorAll('#pc .chip').forEach(c => c.addEventListener('click', () => { pos = c.dataset.p; document.querySelectorAll('#pc .chip').forEach(x => x.classList.toggle('on', x === c)); apply(); }));
    document.querySelectorAll('#ptab th[data-k]').forEach(th => th.addEventListener('click', () => sortBy(th.dataset.k)));
    apply();
  </script>
</Base>
