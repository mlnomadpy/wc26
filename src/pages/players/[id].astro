---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import FutCard from '@entities/player/ui/FutCard.astro';
import DB from '../../../public/data.json';
import { indexes, slugify, POSC, num, money, flagImg, rating } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const IDX = indexes(DB);
export function getStaticPaths() {
  return DB.players.map(p => ({ params: { id: String(p.player_id) } }));
}
const p = IDX.playerById[Astro.params.id];
const srcs = String(p.enrichment_sources || '').split(' ; ').map(s => s.trim()).filter(s => /^https?:/.test(s));
const stat = (k, l, fmt = num) => p[k] != null ? { v: fmt(p[k]), l } : null;
const intl = [stat('caps', 'Caps'), stat('international_goals', 'Goals')].filter(Boolean);
const club = [['club_apps_2025_26', 'Apps'], ['club_starts_2025_26', 'Starts'], ['club_minutes_2025_26', 'Minutes'], ['club_goals_2025_26', 'Goals'], ['club_assists_2025_26', 'Assists'], ['club_yellow_2025_26', 'Yellow'], ['club_red_2025_26', 'Red'], ['club_clean_sheets_2025_26', 'Clean sheets'], ['club_goals_conceded_2025_26', 'Conceded']].map(([k, l]) => stat(k, l)).filter(Boolean);
const rec = [['team_wins_2025_26', 'Won'], ['team_draws_2025_26', 'Drew'], ['team_losses_2025_26', 'Lost']].map(([k, l]) => stat(k, l)).filter(Boolean);
const career = [['career_club_apps', 'Career apps'], ['career_club_goals', 'Career goals']].map(([k, l]) => stat(k, l)).filter(Boolean);
const hasStory = !!(p.backstory || (p.facts && p.facts.length) || srcs.length);
const STATS = [['Rating', rating(p), true], p.caps != null && ['Caps', num(p.caps)], p.international_goals != null && ['Goals', num(p.international_goals)], p.market_value_eur && ['Value', money(p.market_value_eur)], p.age && ['Age', p.age], p.height_cm && ['Height', p.height_cm]].filter(Boolean);
const desc = `${p.player_name} — ${p.team_name} (${p.position}) at the 2026 FIFA World Cup. ${p.club}${p.caps ? `, ${p.caps} caps` : ''}${p.international_goals ? `, ${p.international_goals} goals` : ''}. 2025/26 club stats and profile.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Person', name: p.player_name,
  jobTitle: 'Footballer', nationality: p.team_name, birthDate: p.date_of_birth || undefined,
  height: p.height_cm ? p.height_cm + ' cm' : undefined,
  memberOf: [{ '@type': 'SportsTeam', name: p.team_name }, p.club ? { '@type': 'SportsTeam', name: p.club } : undefined].filter(Boolean),
};
---
<Base title={`${p.player_name} — ${p.team_name} | 2026 World Cup profile & stats`} description={desc} jsonld={jsonld}>
  <div class="app-page tv2">
  <header class="tv2-bar" style={`--c:${POSC[p.position]}`}>
    <a class="tv2-back" href={`${B}teams/${p.fifa_code.toLowerCase()}/`} aria-label={p.team_name}>←</a>
    <Flag code={p.fifa_code} cls="tv2-flag" w={80} />
    <div class="tv2-id">
      <h1>{p.player_name}{p.is_captain ? ' (C)' : ''}</h1>
      <span class="tv2-sub">
        <a class="dh-glink" href={`${B}clubs/${slugify(p.club)}/`}>{p.club || '—'}</a> ·
        <span class={`pill ${p.position}`}>{p.position}</span> #{p.shirt_number ?? '–'} ·
        <a class="dh-glink" href={`${B}teams/${p.fifa_code.toLowerCase()}/`}>{p.team_name}</a> · Group {p.group_letter}
      </span>
    </div>
    <div class="tv2-stats">
      {STATS.map(([k, v, hero]) => <span class={`tv2-stat ${hero ? 'hero' : ''}`}><b>{v}</b><i>{k}</i></span>)}
    </div>
  </header>

  <div class="app-grow pv-main">
    <!-- LEFT — the card, always visible -->
    <section class="panel pv-card" style={`--c:${POSC[p.position]}`}>
      <div class="phero-bg" style={`background-image:url(${flagImg(p.fifa_code, 320)})`}></div>
      <FutCard p={p} big />
      {p.fun && p.fun.length > 0 && <div class="funbar">{p.fun.map((f: string) => <span class="funchip">{f}</span>)}</div>}
    </section>

    <!-- RIGHT — tabbed: Stats / Profile / Story -->
    <section class="panel tv2-right">
      <div class="rtabs" id="ptabs">
        <button class="rtab on" data-r="stats">Stats</button>
        <button class="rtab" data-r="profile">Profile</button>
        {hasStory && <button class="rtab" data-r="story">Story</button>}
      </div>

      <div class="rpane" data-r="stats">
        <h3>Club season 2025/26 {p.club_competitions_2025_26 && <span class="tag">{p.club_competitions_2025_26}</span>}</h3>
        {club.length ? <div class="statgrid">{club.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div> : <div class="faint">No verified club-season stats.</div>}
        <div class="sublabel">International</div>
        <div class="statgrid">{intl.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div>
        {rec.length > 0 && <><div class="sublabel">Team record in his matches</div><div class="statgrid">{rec.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div></>}
        {career.length > 0 && <><div class="sublabel">Club career totals</div><div class="statgrid">{career.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div></>}
        {p.form_note && <><div class="sublabel">Form</div><div class="faint">{p.form_note}</div></>}
      </div>

      <div class="rpane" data-r="profile" hidden>
        <div class="kv">
          <span class="k">Date of birth</span><span>{p.date_of_birth || '—'}{p.age ? ` (age ${p.age})` : ''}</span>
          <span class="k">Nationality</span><span><a class="dh-glink" href={`${B}teams/${p.fifa_code.toLowerCase()}/`}>{p.team_name}</a></span>
          <span class="k">Club</span><span>{p.club || '—'}{p.club_country ? ' · ' + p.club_country : ''}</span>
          <span class="k">League</span><span>{p.club_league || '—'}</span>
          <span class="k">Position</span><span><span class={`pill ${p.position}`}>{p.position}</span> · #{p.shirt_number ?? '–'}</span>
          <span class="k">Height</span><span>{p.height_cm ? p.height_cm + ' cm' : '—'}</span>
          <span class="k">Preferred foot</span><span>{p.preferred_foot || '—'}</span>
          <span class="k">Market value</span><span class="mono">{p.market_value_eur ? money(p.market_value_eur) : '—'}</span>
        </div>
      </div>

      {hasStory && (
        <div class="rpane" data-r="story" hidden>
          {p.backstory && <p class="journey">{p.backstory}</p>}
          {p.facts && p.facts.length > 0 && <ul class="pfacts">{p.facts.map((f: string) => <li>{f}</li>)}</ul>}
          {srcs.length > 0 && <><div class="sublabel">Sources</div><div class="srcs">{srcs.map(s => <div class="src"><a href={s} target="_blank" rel="noopener">{s}</a></div>)}</div></>}
        </div>
      )}
    </section>
  </div>
  </div>

  <script>
    const ptabs = document.getElementById('ptabs');
    if (ptabs) {
      const panes = document.querySelectorAll('.pv-main .rpane');
      ptabs.querySelectorAll('.rtab').forEach(b => b.addEventListener('click', () => {
        ptabs.querySelectorAll('.rtab').forEach(x => x.classList.toggle('on', x === b));
        panes.forEach(p => p.hidden = p.dataset.r !== b.dataset.r);
      }));
    }
  </script>
</Base>
