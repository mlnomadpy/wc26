---
import Base from '../../components/Base.astro';
import Flag from '../../components/Flag.astro';
import FutCard from '../../components/FutCard.astro';
import DB from '../../../public/data.json';
import { indexes, slugify, POSC, num, money, flagImg } from '../../lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const IDX = indexes(DB);
export function getStaticPaths() {
  return DB.players.map(p => ({ params: { id: String(p.player_id) } }));
}
const p = IDX.playerById[Astro.params.id];
const clubStats = ['club_apps_2025_26', 'club_starts_2025_26', 'club_minutes_2025_26', 'club_goals_2025_26', 'club_assists_2025_26', 'club_yellow_2025_26', 'club_red_2025_26', 'club_clean_sheets_2025_26', 'club_goals_conceded_2025_26'];
const hasClub = clubStats.some(k => p[k] != null);
const wl = (p.team_wins_2025_26 != null || p.team_losses_2025_26 != null);
const srcs = String(p.enrichment_sources || '').split(' ; ').map(s => s.trim()).filter(s => /^https?:/.test(s));
const stat = (k, l, fmt = num) => p[k] != null ? { v: fmt(p[k]), l } : null;
const intl = [stat('caps', 'Caps'), stat('international_goals', 'Goals')].filter(Boolean);
const club = [['club_apps_2025_26', 'Apps'], ['club_starts_2025_26', 'Starts'], ['club_minutes_2025_26', 'Minutes'], ['club_goals_2025_26', 'Goals'], ['club_assists_2025_26', 'Assists'], ['club_yellow_2025_26', 'Yellow'], ['club_red_2025_26', 'Red'], ['club_clean_sheets_2025_26', 'Clean sheets'], ['club_goals_conceded_2025_26', 'Conceded']].map(([k, l]) => stat(k, l)).filter(Boolean);
const rec = [['team_wins_2025_26', 'Won'], ['team_draws_2025_26', 'Drew'], ['team_losses_2025_26', 'Lost']].map(([k, l]) => stat(k, l)).filter(Boolean);
const career = [['career_club_apps', 'Career apps'], ['career_club_goals', 'Career goals']].map(([k, l]) => stat(k, l)).filter(Boolean);
const desc = `${p.player_name} — ${p.team_name} (${p.position}) at the 2026 FIFA World Cup. ${p.club}${p.caps ? `, ${p.caps} caps` : ''}${p.international_goals ? `, ${p.international_goals} goals` : ''}. 2025/26 club stats and profile.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Person', name: p.player_name,
  jobTitle: 'Footballer', nationality: p.team_name, birthDate: p.date_of_birth || undefined,
  height: p.height_cm ? p.height_cm + ' cm' : undefined,
  memberOf: [{ '@type': 'SportsTeam', name: p.team_name }, p.club ? { '@type': 'SportsTeam', name: p.club } : undefined].filter(Boolean),
};
const StatGrid = (items) => items;
---
<Base title={`${p.player_name} — ${p.team_name} | 2026 World Cup profile & stats`} description={desc} jsonld={jsonld}>
  <a class="btn back" href={`${B}teams/${p.fifa_code.toLowerCase()}/`}>← {p.team_name}</a>
  <section class="phero" style={`--c:${POSC[p.position]}`}>
    <div class="phero-bg" style={`background-image:url(${flagImg(p.fifa_code, 320)})`}></div>
    <FutCard p={p} big />
    <div class="phero-id">
      <div class="phero-eye">
        <a class="nat" href={`${B}teams/${p.fifa_code.toLowerCase()}/`}><Flag code={p.fifa_code} cls="sm" /> {p.team_name}</a>
        <span>Group {p.group_letter}</span><span>#{p.shirt_number ?? '–'}</span>
        <span class={`pill ${p.position}`}>{p.position}</span>{p.is_captain && <span class="cap">Captain</span>}
      </div>
      <h1>{p.player_name}</h1>
      <div class="phero-sub"><a href={`${B}clubs/${slugify(p.club)}/`}>{p.club}</a>{p.club_league ? ' · ' + p.club_league : ''}</div>
      {p.fun && p.fun.length > 0 && <div class="funbar">{p.fun.map((f: string) => <span class="funchip">{f}</span>)}</div>}
      <div class="phero-stats">
        <div class="thstat"><b>{p.caps ?? '—'}</b><span>Caps</span></div>
        <div class="thstat"><b>{p.international_goals ?? '—'}</b><span>Goals</span></div>
        {p.market_value_eur && <div class="thstat"><b>{money(p.market_value_eur)}</b><span>Value</span></div>}
        {p.age && <div class="thstat"><b>{p.age}</b><span>Age</span></div>}
        {p.height_cm && <div class="thstat"><b>{p.height_cm}</b><span>Height cm</span></div>}
      </div>
    </div>
  </section>
  <div class="pcols">
    <div class="panel">
      <h3>Profile</h3>
      <div class="kv">
        <span class="k">Date of birth</span><span>{p.date_of_birth || '—'}{p.age ? ` (age ${p.age})` : ''}</span>
        <span class="k">Club</span><span>{p.club || '—'} · {p.club_country || ''}</span>
        <span class="k">Height</span><span>{p.height_cm ? p.height_cm + ' cm' : '—'}</span>
        <span class="k">Preferred foot</span><span>{p.preferred_foot || '—'}</span>
        <span class="k">Market value</span><span class="mono">{p.market_value_eur ? money(p.market_value_eur) : '—'}</span>
      </div>
      <div class="sublabel">International</div>
      <div class="statgrid">{intl.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div>
    </div>
    <div class="panel">
      <h3>Club season 2025/26 {p.club_competitions_2025_26 && <span class="tag">{p.club_competitions_2025_26}</span>}</h3>
      {hasClub ? <div class="statgrid">{club.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div> : <div class="faint">No verified club-season stats.</div>}
      {rec.length > 0 && <><div class="sublabel">Team record in his matches</div><div class="statgrid">{rec.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div></>}
      {career.length > 0 && <><div class="sublabel">Club career totals</div><div class="statgrid">{career.map(s => <div class="stat"><div class="v mono">{s.v}</div><div class="k">{s.l}</div></div>)}</div></>}
      {p.form_note && <><div class="sublabel">Form</div><div class="faint">{p.form_note}</div></>}
    </div>
    {p.backstory && (
      <div class="panel span">
        <h3>The journey</h3>
        <p class="journey">{p.backstory}</p>
        {p.facts && p.facts.length > 0 && <ul class="pfacts">{p.facts.map((f: string) => <li>{f}</li>)}</ul>}
      </div>
    )}
    {srcs.length > 0 && <div class="panel span srcs"><h3>Sources</h3>{srcs.map(s => <div class="src"><a href={s} target="_blank" rel="noopener">{s}</a></div>)}</div>}
  </div>
</Base>
