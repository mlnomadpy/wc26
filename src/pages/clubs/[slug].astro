---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../../public/data.json';
import { indexes, slugify, monogram, surname, rating, tier, POSC } from '@shared/lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const IDX = indexes(DB);
export function getStaticPaths() {
  const seen = {};
  DB.players.forEach(p => { if (p.club) { const s = slugify(p.club); if (!seen[s]) seen[s] = p.club; } });
  return Object.entries(seen).map(([slug, club]) => ({ params: { slug }, props: { club } }));
}
const { club } = Astro.props;
const ps = (IDX.playersByClub[club] || []).slice().sort((a, b) => rating(b) - rating(a));
const nations = [...new Set(ps.map(p => p.fifa_code))];
const topR = ps.length ? Math.max(...ps.map(p => rating(p))) : 0;
const totApps = ps.reduce((s, p) => s + (p.club_apps_2025_26 || 0), 0);
const totG = ps.reduce((s, p) => s + (p.club_goals_2025_26 || 0), 0);
const face = id => `${B}faces/${id}.jpg`;
const desc = `${club} players at the 2026 FIFA World Cup — ${ps.length} call-ups across ${nations.length} nations. Positions, ratings and 2025/26 stats.`;
const STATS = [['Players', ps.length, true], ['Nations', nations.length], ['Top rating', topR], ['Apps 25/26', totApps], ['Goals 25/26', totG]];
---
<Base title={`${club} at the 2026 World Cup — ${ps.length} players`} description={desc}>
  <div class="app-page club-page">
  <header class="phead club-head">
    <a class="tv2-back" href={B + 'clubs/'} aria-label="All clubs">←</a>
    <span class="club-crest">{monogram(club)}</span>
    <div class="club-id">
      <div class="pe">{ps[0]?.club_league || 'Club'} · {ps[0]?.club_country || ''}</div>
      <h1>{club}</h1>
      <p class="psub">{ps.length} World Cup player{ps.length === 1 ? '' : 's'} across {nations.length} nation{nations.length === 1 ? '' : 's'}.</p>
    </div>
    <div class="club-flags">{nations.slice(0, 8).map(c => <Flag code={c} cls="sm" />)}</div>
    <div class="tv2-stats">
      {STATS.map(([k, v, hero]) => <span class={`tv2-stat ${hero ? 'hero' : ''}`}><b>{v}</b><i>{k}</i></span>)}
    </div>
  </header>

  <div class="app-grow scroll">
    <div class="splgrid club-squad">
      {ps.map(p => (
        <a class="spl" data-pos={p.position} style={`--pc:${POSC[p.position]}`} href={`${B}players/${p.player_id}/`} title={p.player_name}>
          <span class="spl-face">
            <span class="spl-mono">{monogram(p.player_name)}</span>
            <img src={face(p.player_id)} alt="" loading="lazy" onerror="this.remove()" />
            <span class="spl-no">{p.shirt_number ?? ''}</span>
          </span>
          <span class="spl-id">
            <span class="spl-nm">{surname(p.player_name)}{p.is_captain ? ' (C)' : ''}</span>
            <span class="spl-meta"><span class={`pill ${p.position}`}>{p.position}</span> <Flag code={p.fifa_code} cls="sm" /> {p.team_name}</span>
          </span>
          <span class={`lbovr ${tier(p)} spl-ovr`}>{rating(p)}</span>
        </a>
      ))}
    </div>
  </div>
  </div>
</Base>
