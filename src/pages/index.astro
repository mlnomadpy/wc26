---
import Base from '../components/Base.astro';
import DB from '../../public/data.json';
import { flag, money, num } from '../lib/wc.js';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const t = DB.totals, P = DB.players;
const oldest = [...P].filter(p => p.age).sort((a, b) => b.age - a.age)[0];
const youngest = [...P].filter(p => p.age).sort((a, b) => a.age - b.age)[0];
const topVal = [...P].filter(p => p.market_value_eur).sort((a, b) => b.market_value_eur - a.market_value_eur)[0];
const topScorer = [...P].sort((a, b) => (b.international_goals || 0) - (a.international_goals || 0))[0];
const clubCount = {}; P.forEach(p => { if (p.club) clubCount[p.club] = (clubCount[p.club] || 0) + 1; });
const topClub = Object.entries(clubCount).sort((a, b) => b[1] - a[1])[0];
const teamUrl = p => `${B}teams/${p.fifa_code.toLowerCase()}/`;
const playerUrl = p => `${B}players/${p.player_id}/`;
const stories = [
  { big: flag('ARG') + ' ' + flag('POR'), lab: 'The last dance', sub: 'Messi (ARG) & Ronaldo (POR) — likely their final World Cup', href: B + 'compare/' },
  { big: youngest?.age, lab: 'Youngest player', sub: `${youngest?.player_name} ${flag(youngest?.fifa_code)} · ${youngest?.club}`, href: playerUrl(youngest) },
  { big: oldest?.age, lab: 'Oldest player', sub: `${oldest?.player_name} ${flag(oldest?.fifa_code)} · ${oldest?.club}`, href: playerUrl(oldest) },
  { big: topScorer.international_goals, lab: 'Most intl goals', sub: `${topScorer.player_name} ${flag(topScorer.fifa_code)}`, href: playerUrl(topScorer) },
  topVal && { big: money(topVal.market_value_eur), lab: 'Most valuable', sub: `${topVal.player_name} ${flag(topVal.fifa_code)} · ${topVal.club}`, href: playerUrl(topVal) },
  topClub && { big: topClub[1], lab: 'Top club supplier', sub: `${topClub[0]} sends ${topClub[1]} players`, href: B + 'clubs/' },
  { big: '12 → 1', lab: 'Knockout bracket', sub: 'From 48 teams to one champion', href: B + 'bracket/' },
].filter(Boolean);
const explore = [['teams/', 'Teams & lineups', 'Formation pitch, projected XI, bench'], ['players/', 'Players', '1,247 players, filter & compare'], ['matches/', 'Match Centre', '104 matches, head-to-head XIs'], ['map/', 'Host cities', '16 venues on the map'], ['compare/', 'Compare', 'Teams & players side-by-side'], ['insights/', 'Insights', 'Charts, value, age, diaspora'], ['data/', 'Data & sources', 'Coverage, methodology, export']];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'WC26 Matchday', url: 'https://www.tahabouhsine.com' + B, inLanguage: 'en' },
  { '@context': 'https://schema.org', '@type': 'SportsEvent', name: 'FIFA World Cup 2026', sport: 'Association football', startDate: '2026-06-11', endDate: '2026-07-19', location: [{ '@type': 'Country', name: 'United States' }, { '@type': 'Country', name: 'Canada' }, { '@type': 'Country', name: 'Mexico' }] },
];
---
<Base title="WC26 Matchday — FIFA World Cup 2026 Squads, Lineups & Bracket" description="Explore every 2026 FIFA World Cup squad, projected lineup, club and match — 1,247 players across 48 teams and 104 matches, with an interactive bracket, comparisons and stats." jsonld={jsonld}>
  <section class="hero">
    <div class="eyebrow">JUNE 11 – JULY 19, 2026 · USA · CANADA · MEXICO</div>
    <h1>The first <span class="accent">48-team</span> World Cup, in data.</h1>
    <p class="lede">{num(t.players)} players · {t.teams} nations · {t.clubs} clubs · {t.matches} matches across {t.host_cities} cities. Explore every squad, build lineups, and trace the road to the final.</p>
    <div class="herobtns">
      <a class="btn primary" href={B + 'teams/'}>Browse teams</a>
      <a class="btn" href={B + 'bracket/'}>Road to the final</a>
      <button class="btn ghost" onclick="document.getElementById('palBtn').click()">⌘K  Search anything</button>
    </div>
  </section>

  <h2 class="sec">Storylines</h2>
  <div class="storygrid">
    {stories.map(s => <a class="story" href={s.href}><div class="big">{s.big}</div><div class="lab">{s.lab}</div><div class="sub faint">{s.sub}</div></a>)}
  </div>

  <h2 class="sec">Explore</h2>
  <div class="explore">
    {explore.map(([u, h, s]) => <a class="ecard" href={B + u}><div class="eh">{h}</div><div class="faint">{s}</div></a>)}
  </div>
</Base>
