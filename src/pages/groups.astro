---
import Base from '@app/layouts/Base.astro';
import Flag from '@shared/ui/Flag.astro';
import DB from '../../public/data.json';
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const byG = {}; DB.teams.forEach(t => { (byG[t.group_letter] = byG[t.group_letter] || []).push(t); });
const groups = Object.keys(byG).sort();
const fixtures = g => DB.matches.filter(m => m.match_label === 'Group ' + g).length;
---
<Base title="Groups — FIFA World Cup 2026 group stage (A–L)" description="The 2026 FIFA World Cup group stage: all 12 groups (A–L), the four teams in each, and fixture counts.">
  <div class="app-page">
  <header class="phead">
    <div>
      <div class="pe">Group stage</div>
      <h1>Groups A–L</h1>
      <p class="psub">Twelve groups of four. The top two from each — plus the eight best third-placed teams — reach the Round of 32.</p>
    </div>
    <div class="pstat"><div class="s"><b>12</b><span>Groups</span></div><div class="s"><b>72</b><span>Group games</span></div></div>
  </header>
  <div class="app-grow scroll">
  <div class="tgrid">
    {groups.map(g => (
      <div class="gcard">
        <a class="gh gh-link" href={`${B}groups/${g}/`}>Group {g} →</a>
        <table class="gtable">
          <thead><tr><th>Team</th><th>Conf</th><th>Rk</th></tr></thead>
          <tbody>
            {byG[g].map(t => (
              <tr onclick={`location.href='${B}teams/${t.fifa_code.toLowerCase()}/'`}>
                <td><span class="nat"><Flag code={t.fifa_code} cls="sm" /> {t.team_name}</span></td>
                <td class="faint">{t.confederation}</td>
                <td class="mono">{t.fifa_ranking ? '#' + t.fifa_ranking : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <a class="sublabel gh-link" href={`${B}groups/${g}/`}>{fixtures(g)} fixtures · projected standings →</a>
      </div>
    ))}
  </div>
  </div>
  </div>
</Base>
