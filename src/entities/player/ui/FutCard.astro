---
import Flag from '@shared/ui/Flag.astro';
import { rating, tier, tierName, SPECIAL, monogram } from '@shared/lib/wc.js';
const { p, big = false } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const r = rating(p);
const tr = tier(p);
const badge = SPECIAL.has(tr) ? tierName(tr) : null;
// face: real photo if present (public/faces/<id>.png), else an avatar placeholder, else monogram
const avatar = `https://api.dicebear.com/9.x/micah/svg?seed=${encodeURIComponent(p.player_name)}&radius=0&backgroundColor=transparent`;
const faceUrl = `${B}faces/${p.player_id}.jpg`;
const stats = p.position === 'GK'
  ? [['CS', p.club_clean_sheets_2025_26], ['GC', p.club_goals_conceded_2025_26],
     ['APP', p.club_apps_2025_26], ['CAP', p.caps], ['MIN', p.club_minutes_2025_26], ['AGE', p.age]]
  : [['GLS', p.international_goals], ['AST', p.club_assists_2025_26],
     ['CG', p.club_goals_2025_26], ['APP', p.club_apps_2025_26], ['CAP', p.caps], ['AGE', p.age]];
---
<a class={`fut ${tr}${big ? ' big' : ''}`} href={`${B}players/${p.player_id}/`} title={p.player_name} style={`--ovr:${r}`} data-tilt>
  <div class="fut-sheen"></div>
  <div class="fut-glare"></div>
  {badge && <span class="fut-badge">{badge}</span>}
  <div class="fut-hero">
    <span class="fut-mono">{monogram(p.player_name)}</span>
    <img class="fut-img" src={faceUrl} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${avatar}'`} />
    <div class="fut-rail">
      <div class="fut-ovr"><b>{r}</b><span>{p.position}</span></div>
      <span class="fut-rdiv"></span>
      <Flag code={p.fifa_code} />
      {p.shirt_number != null && <span class="fut-num">{p.shirt_number}</span>}
      {p.is_captain && <span class="fut-cap">C</span>}
    </div>
  </div>
  <div class="fut-name">{p.player_name}</div>
  <div class="fut-stats">
    {stats.map(([k, v]) => <span><b>{v ?? '–'}</b><i>{k}</i></span>)}
  </div>
</a>
